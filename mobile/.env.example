# 이 파일을 .env.local 로 복사해서 값을 채운다.
# .env 가 아니라 .env.local 이어야 한다 — Expo는 REACT_NATIVE_PACKAGER_HOSTNAME을
# 개발자 개인 설정으로 분류해 .local 파일만 허용한다.

# 개발 서버가 QR/접속 URL에 광고할 호스트.
# 폰과 PC가 같은 네트워크에 있으면 생략 가능하다.
# 교육기관/사내 WiFi의 AP 격리나 폰이 LTE인 환경에서는 Tailscale IP를 넣는다.
# 값 확인: tailscale status 에서 이 PC의 100.x.y.z 주소
REACT_NATIVE_PACKAGER_HOSTNAME=100.x.y.z

# Phase 2에서 백엔드를 붙일 때 사용한다. Phase 1에서는 불필요.
# EXPO_PUBLIC_ 접두사가 붙은 값은 JS 번들에 그대로 박히므로 비밀값을 넣지 않는다.
# EXPO_PUBLIC_API_URL=https://your-domain.example.com
